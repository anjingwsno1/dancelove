# Browser development: demo. WeChat-only login (no demo accounts): wechat.
HOST=127.0.0.1
PORT=8787
APP_MODE=demo
DATA_DIR=./data
# APP_MODE=wechat 时默认用 mysql，demo 时默认用 sqlite；也可明确指定。
DATABASE_PROVIDER=
# 视频默认保存在 DATA_DIR/media；设置 cos 并填写下列 COS 配置可使用对象存储。
MEDIA_PROVIDER=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PREFIX=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional system binaries, otherwise bundled binaries are used.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
