page{background:#f8f7f4;color:#30382d;font-family:-apple-system,'PingFang SC',sans-serif;font-size:27rpx}.page{padding:30rpx}.eyebrow{font-size:18rpx;color:#8a957e;letter-spacing:5rpx}.heading{font-size:42rpx;font-weight:500;margin:12rpx 0 28rpx}.muted{color:#939d88;font-size:23rpx;line-height:1.8}.primary,.secondary{border-radius:12rpx;font-size:27rpx;line-height:1.5;padding:23rpx 28rpx;margin:20rpx 0}.primary{background:#6b805a;color:white}.secondary{background:#edf0e7;color:#667c54}button::after{border:none}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.notice{background:#f0ece3;color:#9a8b71;font-size:23rpx;line-height:1.8;padding:22rpx;border-radius:12rpx;margin:24rpx 0}.field{margin:24rpx 0}.label{display:block;font-size:25rpx;margin-bottom:14rpx}.input,.picker{background:white;border:1rpx solid #e0e4d9;border-radius:10rpx;padding:22rpx;font-size:26rpx}.empty{text-align:center;padding:70rpx 25rpx;border:1rpx dashed #d9dfcf;border-radius:18rpx;color:#8e9b7d;line-height:2}.tag{font-size:22rpx;color:#889975}.poetry{font-family:'KaiTi','STKaiti','Songti SC',serif;letter-spacing:6rpx}.bold{font-weight:900;font-style:italic;letter-spacing:2rpx}.minimal{font-weight:300;letter-spacing:8rpx}.cover-title{position:absolute;left:22rpx;bottom:26rpx;font-size:43rpx;text-shadow:0 3rpx 12rpx #0008;max-width:90%;z-index:1}.footer{text-align:center;color:#a0a892;font-size:18rpx;letter-spacing:4rpx;padding:45rpx 0}.error{background:#f5e8e3;color:#a26d56;padding:20rpx;border-radius:10rpx;margin-bottom:20rpx}
.cover-title{left:50%;top:50%;bottom:auto;transform:translate(-50%,-50%);width:88%;max-width:none;text-align:center}
