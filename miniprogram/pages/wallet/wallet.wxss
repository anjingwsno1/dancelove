.balance{justify-content:flex-start;gap:70rpx;background:#e8ecdf;padding:40rpx;border-radius:18rpx;margin-bottom:30rpx}.number{font:72rpx Georgia;color:#6b805a;margin-bottom:12rpx}.amount-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin-top:35rpx}.amount{border:2rpx solid #e2e6d9;background:white;border-radius:16rpx;padding:30rpx;font-size:45rpx}.selected{border-color:#6b805a;background:#edf2e5}.amount input{font-size:30rpx;margin-top:14rpx}.small{font-size:31rpx;margin-top:48rpx}.order{padding:25rpx 0;border-bottom:1rpx solid #e0e5d5}
