<view class="page"><view wx:if="{{error}}" class="error" bindtap="retry">{{error}} · 点击重试</view><block wx:if="{{video}}"><view class="eyebrow">A MOMENT IN MOTION</view><view class="heading">{{video.title}}</view><video wx:if="{{video.playUrl}}" class="player" src="{{video.playUrl}}" poster="{{video.coverUrl}}" controls object-fit="contain" binderror="playbackError"/><view wx:else class="empty"><view>{{video.statusText}}</view><view class="muted">{{video.reason||'等待管理员审核，暂不可观看、下载或互动。'}}</view></view><view class="meta">{{video.ownerName}} · {{video.categoryName}} · {{video.visibility==='private'?'仅自己可见':'公有'}} · {{video.durationText}}</view><view class="tags"><text wx:for="{{video.tags}}" wx:key="*this" class="tag">#{{item}}　</text></view><view wx:if="{{review}}"><view class="notice">仅供管理员审核。私有作品审核通过后，仍然只有上传者本人可以观看。</view><textarea class="input" placeholder="驳回原因（驳回时必填）" maxlength="200" bindinput="reason" value="{{reason}}"/><view class="row"><button class="primary" data-decision="approved" bindtap="review" disabled="{{busy}}">通过审核</button><button class="secondary" data-decision="rejected" bindtap="review" disabled="{{busy}}">驳回作品</button></view></view><view wx:elif="{{video.status==='approved'}}"><view class="row"><button class="secondary" data-kind="like" bindtap="reaction" disabled="{{busy}}">{{video.liked?'♥ 已点赞':'♡ 点赞'}} {{video.likes}}</button><button class="secondary" data-kind="favorite" bindtap="reaction" disabled="{{busy}}">{{video.favorited?'★ 已收藏':'☆ 收藏'}}</button></view><button class="primary" bindtap="download" loading="{{busy}}" disabled="{{busy}}">↓ 下载到相册</button><view class="muted" bindtap="openSettings">无法保存？点击管理相册权限</view></view><button class="secondary" bindtap="retry">刷新作品</button></block></view>
