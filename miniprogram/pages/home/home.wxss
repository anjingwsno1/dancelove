@import "./categories.wxss";
.top{margin-bottom:30rpx}.wordmark{font-family:serif;font-size:42rpx;letter-spacing:8rpx}.hero{position:relative;overflow:hidden;background:#edeee5;border-radius:24rpx;padding:40rpx 32rpx}.hero-title{font-family:serif;font-size:46rpx;margin:25rpx 0 18rpx}.hero-title text{color:#6b805a}.hero .primary{width:340rpx;margin:32rpx 0 0;font-size:25rpx;position:relative;z-index:1}.ninety{position:absolute;right:0;bottom:-30rpx;font:italic 140rpx Georgia;color:#7b906329}.quota{font-size:22rpx;color:#8c987f;padding:30rpx 0}.quota text:last-child{color:#61744e}.tabs{white-space:nowrap;margin:10rpx 0 28rpx}.tab{display:inline-block;margin-right:35rpx;padding:10rpx 0;font-size:28rpx;color:#9ba38f}.selected{color:#455738;border-bottom:4rpx solid #6b805a}.search{margin-bottom:26rpx}.categories{white-space:nowrap;margin-bottom:28rpx}.chip{display:inline-block;font-size:23rpx;color:#89957c;padding:12rpx 23rpx;margin-right:8rpx;border-radius:30rpx}.active{background:#35422d;color:white}.grid{display:grid;grid-template-columns:1fr 1fr;gap:28rpx 22rpx}.cover{position:relative;width:100%;height:275rpx;border-radius:18rpx;overflow:hidden}.cover image{width:100%;height:100%}.duration,.private{position:absolute;right:16rpx;top:16rpx;font-size:18rpx;background:#0005;color:white;padding:4rpx 10rpx;border-radius:6rpx}.private{right:auto;left:16rpx}.info{font-size:25rpx;margin-top:15rpx}.author{font-size:21rpx;margin-top:6rpx}
