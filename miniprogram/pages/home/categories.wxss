.wordmark.english{font:30rpx Georgia,serif;letter-spacing:3rpx}.category-item{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #e1e6d8}.category-item.child-category{padding-left:30rpx;background:#f4f6f0}.mini-button{font-size:23rpx;padding:15rpx 21rpx;margin:0;border-radius:10rpx;background:#edf0e7;color:#667c54}.mini-button.danger{color:#a17665;background:#f1e8e2}.delete-panel{position:fixed;left:30rpx;right:30rpx;top:24%;z-index:10;padding:28rpx;background:#f8f7f4;border-radius:18rpx;box-shadow:0 0 0 2000rpx #25302088}.delete-panel .heading{font-size:32rpx}.category-item .row{gap:12rpx}
