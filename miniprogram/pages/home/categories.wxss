.wordmark.english{font:30rpx Georgia,serif;letter-spacing:3rpx}
.nickname-card{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 22rpx;margin-bottom:24rpx;background:#f0f2eb;border-radius:14rpx}
.nickname-info{display:flex;flex-direction:column;min-width:0}.nickname-label{font-size:21rpx;color:#8a957e}.nickname-value{font-size:27rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nickname-edit{flex:none;margin:0;padding:8rpx 16rpx;font-size:22rpx;line-height:1.5;color:#667c54;background:white;border-radius:9rpx}
.nickname-panel{padding:22rpx;margin-bottom:24rpx;background:#f0f2eb;border-radius:14rpx}.nickname-actions{display:flex;gap:16rpx}.nickname-actions button{flex:1;margin-bottom:0}
.category-item{padding:22rpx;margin:16rpx 0;background:white;border:1rpx solid #e1e6d8;border-radius:14rpx;box-sizing:border-box}
.category-item.child-category{margin-left:24rpx;background:#f4f6f0}
.category-info{min-width:0}.category-name{display:block;font-size:28rpx;line-height:1.5;word-break:break-all}.category-info .muted{margin-top:4rpx}
.category-actions{display:flex;gap:12rpx;margin-top:14rpx}.mini-button{flex:1;min-width:0;font-size:23rpx;padding:12rpx;margin:0;border-radius:10rpx;background:#edf0e7;color:#667c54}.mini-button.danger{color:#a17665;background:#f1e8e2}
.delete-panel{position:fixed;left:30rpx;right:30rpx;top:24%;z-index:10;padding:28rpx;background:#f8f7f4;border-radius:18rpx;box-shadow:0 0 0 2000rpx #25302088}.delete-panel .heading{font-size:32rpx}
.users-scroll{width:100%;margin-top:24rpx;background:white;border:1rpx solid #e1e6d8;border-radius:12rpx;box-sizing:border-box}
.users-table{width:720rpx}.users-row{display:grid;grid-template-columns:220rpx 220rpx 140rpx 140rpx;align-items:center;min-height:82rpx;border-bottom:1rpx solid #e1e6d8;font-size:23rpx}.users-row:last-child{border-bottom:0}.users-row>text,.users-role{padding:12rpx 14rpx;box-sizing:border-box}.users-header{background:#edf0e7;color:#667c54;font-weight:600}.users-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.users-role{display:flex;align-items:center;gap:8rpx;white-space:nowrap}.role-edit{margin:0;padding:6rpx 10rpx;font-size:20rpx;line-height:1.4;background:#edf0e7;color:#667c54;border-radius:8rpx}
